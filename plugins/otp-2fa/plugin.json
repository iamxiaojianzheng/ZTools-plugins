{
  "$schema": "../node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "@ruck-plugins/otp-2fa",
  "pluginType": "ui",
  "title": "2FA动态验证码",
  "description": "安全、简约且高效的 2FA 令牌管理器，支持 TOTP/HOTP/Steam 多种协议。",
  "author": "狄硕",
  "homepage": "https://github.com/dishuo183/ZTools-plugins",
  "version": "1.0.0",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "permissions": [
    "clipboard_read",
    "clipboard_write",
    "window_control",
    "notification",
    "storage_get",
    "storage_put",
    "storage_delete"
  ],
  "development": {
    "main": "http://localhost:5173"
  },
  "platform": ["win32", "darwin", "linux"],
  "ai": true,
  "features": [
    {
      "code": "otp-2fa",
      "explain": "管理和查看您的 2FA 动态验证码",
      "icon": "logo.png",
      "cmds": [
        "2fa",
        "otp",
        "验证码",
        "动态验证码",
        "otp-2fa",
        "yzm",
        "yjvgma",
        "yanzhengma"
      ]
    },
    {
      "code": "otp-search",
      "explain": "快捷查询 2FA 动态验证码并自动复制粘贴",
      "icon": "logo.png",
      "mainPush": true,
      "cmds": [
        "2fa",
        "otp",
        "验证码",
        {
          "type": "regex",
          "label": "2FA验证码搜索",
          "match": "/^(?:2fa|otp|yzm|验证码)\\s+(.+)/i"
        }
      ]
    }
  ]
}
