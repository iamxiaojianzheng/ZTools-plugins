{
  "name": "@ruck-plugins/wifi-export-tool",
  "version": "1.0.3",
  "title": "WiFi历史密码查看器",
  "description": "查看设备上保存的所有 WiFi 网络及其密码。",
  "author": "wangtao",
  "pluginType": "ui",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.svg",
  "height": 600,
  "permissions": [
    {
      "shell_execute": [
        "netsh",
        "networksetup",
        "security",
        "nmcli",
        "cmd",
        "cmd.exe"
      ]
    },
    "system_info",
    "clipboard_write",
    "window_control"
  ],
  "features": [
    {
      "code": "wifi-export-tool",
      "explain": "查看已保存的WiFi密码",
      "cmds": ["wifi", "wifipassword", "无线网络", "密码"]
    }
  ]
}
