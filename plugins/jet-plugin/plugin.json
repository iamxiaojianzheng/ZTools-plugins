{
  "$schema": "node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "@ruck-plugins/jet-plugin",
  "title": "JetBrains 项目启动器",
  "description": "扫描本机已安装的 JetBrains IDE，聚合各 IDE 最近打开的项目，支持模糊搜索与一键启动",
  "author": "zl",
  "version": "1.2.3",
  "pluginType": "ui",
  "platform": [
    "win32",
    "darwin",
    "linux"
  ],
  "preload": "preload.js",
  "logo": "logo.png",
  "permissions": [
    "file_system_read",
    {
      "shell_execute": [
        "idea64.exe",
        "idea.exe",
        "idea",
        "webstorm64.exe",
        "webstorm.exe",
        "webstorm",
        "pycharm64.exe",
        "pycharm.exe",
        "pycharm",
        "goland64.exe",
        "goland.exe",
        "goland",
        "clion64.exe",
        "clion.exe",
        "clion",
        "rider64.exe",
        "rider.exe",
        "rider",
        "rustrover64.exe",
        "rustrover.exe",
        "rustrover",
        "rubymine64.exe",
        "rubymine.exe",
        "rubymine",
        "datagrip64.exe",
        "datagrip.exe",
        "datagrip",
        "fleet.exe",
        "fleet",
        "aqua64.exe",
        "aqua.exe",
        "aqua",
        "open",
        "cmd.exe",
        "cmd",
        "powershell.exe",
        "powershell",
        "explorer.exe",
        "explorer"
      ]
    },
    "window_control",
    "notification",
    "system_info",
    "clipboard_write"
  ],
  "features": [
    {
      "code": "all",
      "explain": "快速打开 JetBrains IDE 全家桶最近项目",
      "cmds": [
        "IDE",
        "JetBrains",
        "History",
        "KK",
        "JetHistory",
        "JJ",
        "JH",
        "jb"
      ]
    }
  ]
}
