{
  "$schema": "node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "@ruck-plugins/process-manager",
  "title": "进程端口管理",
  "pluginName": "进程端口管理",
  "description": "快速搜索进程、端口、PID、路径，支持一键 Kill 进程，支持深色模式",
  "author": "Agitator",
  "version": "1.2.0",
  "pluginType": "ui",
  "homepage": "https://github.com/Code-Agitator/process-manager",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.svg",
  "development": {
    "main": "http://localhost:5173"
  },
  "permissions": [
    {
      "shell_execute": [
        "win-file-lock-detector.exe",
        "win-file-lock-detector",
        "bin/win-file-lock-detector.exe",
        "bin\\win-file-lock-detector.exe",
        "powershell.exe",
        "powershell",
        "taskkill.exe",
        "taskkill",
        "netstat.exe",
        "netstat",
        "wmic.exe",
        "wmic",
        "cmd.exe",
        "cmd",
        "explorer.exe",
        "explorer"
      ]
    },
    "clipboard_read",
    "clipboard_write",
    "window_control",
    "system_info"
  ],
  "features": [
    {
      "code": "process",
      "explain": "快速搜索进程、端口、PID，支持一键 Kill",
      "icon": "logo.svg",
      "cmds": [
        "pid",
        "port",
        "process",
        "端口",
        "进程",
        "进程管理"
      ]
    }
  ],
  "platform": [
    "win32"
  ]
}