{
  "$schema": "node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "@ruck-plugins/easynssm",
  "title": "EasyNssm 服务管理",
  "pluginName": "EasyNssm 服务管理",
  "description": "nssm 的友好图形界面：安装/编辑/卸载 nssm 服务、查看服务日志；同时支持系统服务的查看与启停",
  "author": "咖啡八杯",
  "version": "1.0.1",
  "pluginType": "ui",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "permissions": [
    {
      "shell_execute": [
        "powershell.exe",
        "powershell",
        "sc.exe",
        "sc",
        "where.exe",
        "where",
        "nssm.exe",
        "nssm"
      ]
    },
    "clipboard_read",
    "clipboard_write",
    "window_control",
    "system_info"
  ],
  "features": [
    {
      "code": "main",
      "explain": "nssm 与 Windows 服务的图形化管理",
      "icon": "logo.png",
      "cmds": [
        "nssm",
        "服务",
        "svc"
      ]
    }
  ],
  "platform": [
    "win32"
  ]
}
