{
  "$schema": "node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "@ruck-plugins/todos",
  "pluginType": "ui",
  "title": "Todos待办",
  "description": "高颜值、快捷高效的待办事项管理工具，支持日历视图与拖拽操作",
  "author": "Agitator",
  "version": "1.0.1",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "permissions": [
    "clipboard_write",
    "window_control",
    "notification",
    "storage_get",
    "storage_put",
    "storage_delete"
  ],
  "features": [
    {
      "code": "Todos",
      "explain": "打开待办日历主界面",
      "icon": "logo.svg",
      "cmds": [
        "todos",
        "待办日历",
        "待办"
      ]
    },
    {
      "code": "add",
      "explain": "快捷添加待办事项",
      "icon": "logo.svg",
      "mainPush": true,
      "cmds": [
        "todo",
        "待办",
        "添加待办",
        {
          "type": "regex",
          "label": "添加待办",
          "match": "/^(todo|待办)\\s+(.+)/i"
        },
        {
          "type": "over",
          "label": "添加待办"
        }
      ]
    }
  ]
}
